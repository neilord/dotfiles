#!/usr/bin/env sh
# Managed by Stow at ~/.config/yabai/yabairc.

yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

yabai -m config \
    layout                bsp          \
    window_placement      second_child \
    split_ratio           0.50         \
    split_type            auto         \
    auto_balance          off          \
    mouse_follows_focus   off          \
    focus_follows_mouse   off          \
    window_shadow         float        \
    top_padding           0            \
    bottom_padding        0            \
    left_padding          0            \
    right_padding         0            \
    window_gap            0             \
    mouse_modifier        fn           \
    mouse_action1         move         \
    mouse_action2         resize       \
    mouse_drop_action     swap

# Overlays and launchers: never tiled.
yabai -m rule --add app="^(Wispr Flow|Raycast|Homerow)$" manage=off

# Not managed apps
yabai -m rule --add app="^(Finder|TextSniper|aText|Archiver|Digital Color Meter|Karabiner-EventViewer|Karabiner-Elements|LuLu|Calculator|Software Update|Dictionary|VLC|mpv|System Settings|zoom.us|Photo Booth|Archive Utility|Python|App Store|Steam|Activity Monitor)$" manage=off
yabai -m rule --add label="About This Mac" app="System Information" title="About This Mac" manage=off

# Closing a window shouldn't leave the keyboard with nothing focused.
yabai -m signal --add event=window_destroyed action="yabai -m query --windows --window >/dev/null 2>&1 || yabai -m window --focus recent"

# Keep the keyboard on the Space you can see.
yabai -m signal --add event=space_changed action="\"${XDG_CONFIG_HOME:-$HOME/.config}/yabai/settle_focus.sh\""

echo "yabai configuration loaded.."
