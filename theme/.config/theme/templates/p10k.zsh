# Prompt colors that aren't one of the terminal's 16, rendered by ~/.config/theme/theme.
# ~/.zshrc sources this after ~/.p10k.zsh, and again with `p10k reload` when the theme changes.
typeset -g POWERLEVEL9K_DIR_FOREGROUND='{{on_accent}}'
typeset -g POWERLEVEL9K_DIR_SHORTENED_FOREGROUND='{{on_accent_dim}}'
typeset -g POWERLEVEL9K_DIR_ANCHOR_FOREGROUND='{{on_accent}}'
