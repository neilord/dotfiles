[include]
	path = ~/.local/state/theme/delta.gitconfig # delta colors, rendered by ~/.config/theme
[user]
	name = neilord
	email = arshostak@gmail.com
[core]
	excludesfile = ~/.config/git/ignore
	editor = nvim
	pager = delta
	quotepath = false # show non-ASCII file names as they are
[interactive]
	diffFilter = delta --color-only
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
	algorithm = histogram
[pull]
	ff = true
[init]
	defaultBranch = main
[alias]
	lg1 = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)' --all
	lg2 = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(auto)%d%C(reset)%n''          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)'
	lg = lg1
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[fetch]
	prune = true
[push]
	autoSetupRemote = true
[rebase]
	autoStash = true
[rerere]
	enabled = true # reuse recorded conflict resolutions
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[delta]
	navigate = true # n / N jump between files in a diff
